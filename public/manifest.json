{
  "manifest_version": 3,
  "name": "Bookmark Graph New Tab",
  "short_name": "Bookmark Graph",
  "version": "0.1.0",
  "description": "Explore, search, and edit Chrome bookmarks as an Obsidian-style graph.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["bookmarks", "history", "topSites", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
